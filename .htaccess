# WellFinder — public_html root
# Extensionless public pages are served as HTML.

DirectoryIndex index.html

<IfModule mod_mime.c>
  AddType text/html .html
</IfModule>

<FilesMatch "^(pilates|naturopath|golf|about|submit|discover|saved)$">
  ForceType text/html
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # /page.html (or any old bookmark/search-engine link) -> /page
  RewriteCond %{THE_REQUEST} \s/+([^?\s]+)\.html[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L]
</IfModule>

Options -Indexes
