<button class="nav-toggle" aria-label="Toggle menu" aria-expanded="false" aria-controls="mobileMenu"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 7h16M4 12h16M4 17h16"/></svg></button>
</nav></div>
<div class="mobile-menu" id="mobileMenu"><a href="/#directory">Browse treatments</a><a href="/pilates">Pilates clinics</a><a href="/naturopath">Naturopathic clinics</a><a href="/golf">Golf clinics</a></div>
</header>
<main>
<section class="saved-hero"><div class="wrap saved-hero-inner">
<div><p class="eyebrow">My wellness</p><h1>My wellness page</h1><p>Your saved treatments and clinics, plus clinics near you.</p></div>
<div class="saved-count-card"><strong id="savedCount">0</strong><span>saved</span></div>
</div></section>

<section class="wrap saved-section">
<div class="saved-toolbar"><p>Your shortlist</p><button id="clearSaved" type="button">Clear all</button></div>
<h2 class="saved-h2">Saved treatments</h2>
<div class="saved-tx-list" id="savedTreatments"></div>
<h2 class="saved-h2">Saved clinics</h2>
<div class="saved-grid" id="savedClinics"></div>
<section class="saved-empty" id="savedEmpty" hidden><span aria-hidden="true">♡</span><h2>Your shortlist is waiting.</h2><p>Save treatments and clinics to build your shortlist.</p><a class="btn btn--primary" href="/#directory">Browse treatments</a></section>
</section>

<section class="wrap saved-section" id="forYouWrap">
<p class="eyebrow">For you</p>
<h2>Clinics for your saved treatments</h2>
<p id="forYouSub">Save treatments to get clinic recommendations.</p>
<form id="postalForm" class="postal-form">
<input id="postalInput" placeholder="Postal code, e.g. M4B 1B3" autocomplete="postal-code">
<button class="btn btn--primary btn--sm" type="submit">Find clinics</button>
</form>
<p class="gate-error" id="postalError" hidden></p>
<div class="radius-wrap" id="radiusWrap" hidden>
<label for="radiusInput">Search radius: <strong id="radiusLabel">Within 25 km</strong></label>
<input type="range" id="radiusInput" min="5" max="50" step="5" value="25">
</div>
<div class="clinic-grid" id="forYouGrid"></div>
</section>

<section class="wrap saved-section" id="savedRecWrap">
<p class="eyebrow">For you</p>
<h2>Recommended treatments</h2>
<p>Based on what you save and what is near you.</p>
<div class="near-list" id="savedRecGrid"></div>
</section>

<section class="saved-email">
<div><p class="eyebrow">Don’t lose your list</p><h2>Keep your list close.</h2><p>Add your email and we will keep your wellness page ready for your next visit.</p></div>
<form id="savedEmailForm"><label for="savedEmail">Email address</label><div><input id="savedEmail" type="email" autocomplete="email" placeholder="you@example.com" required><button class="btn btn--honey" type="submit">Save email</button></div><small id="savedEmailStatus">No spam. Unsubscribe anytime.</small></form>
</section>
</main>
