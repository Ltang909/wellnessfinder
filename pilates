  <section class="subhero">
    <div class="wrap">
      <a class="back" href="/">← Back to WellFinder</a>
      <p class="eyebrow">A WellFinder directory</p>
      <h1>Every naturopathic aesthetics clinic, <em>mapped and priced.</em></h1>
      <p>Microneedling, cosmetic acupuncture, IV drips, and vitamin injections tucked inside your naturopathic benefits. I haven't personally tried every clinic below — some are gathered leads. Please confirm modality, pricing, and direct billing directly with each clinic before booking.</p>
      <div class="subhero-actions">
        <a class="btn btn--primary btn--sm" href="/submit">Suggest a provider</a>
        <button class="btn btn--ghost btn--sm" data-share type="button">Share this list</button>
      </div>
    </div>
  </section>

  <section class="section--tight">
    <div class="wrap">
      <div class="filters">
        <div class="filters-row">
          <div class="filter-field" style="flex:1 1 100%">
            <label for="searchBox">Search providers</label>
            <input type="search" id="searchBox" class="search-input" placeholder="Search by name, city, or modality…">
          </div>
          <div class="filter-field">
            <label>Province</label>
            <div class="seg" id="provSeg">
              <button class="active" data-val="">All</button>
              <button data-val="ON">ON</button>
              <button data-val="BC">BC</button>
              <button data-val="AB">AB</button>
            </div>
          </div>
          <div class="filter-field">
            <label for="citySelect">Search by city</label>
            <select id="citySelect"></select>
          </div>
          <div class="filter-field" style="flex:1 1 100%">
            <label>Filter by modality</label>
            <div class="chip-row" id="chipRow"></div>
          </div>
        </div>
        <div class="filters-foot">
          <span></span>
          <button class="reset-btn" id="resetBtn" type="button">Reset filters</button>
        </div>
      </div>

      <div class="result-bar" id="resultBar">
        <strong><span id="resultCount">0</span> <span id="resultNoun">clinics</span></strong>
        <span id="resultTotal"></span>
      </div>

      <div class="clinic-list" id="clinicList"></div>
