# WellFinder — public_html root
# Extensionless public pages are served as HTML.

DirectoryIndex index.html

<IfModule mod_mime.c>
  AddType text/html .html
</IfModule>

<FilesMatch "^(pilates|naturopath|golf|about|submit|saved|404|blog-clinical-pilates|blog-clinical-vs-group-pilates|blog-tpi-golf-assessment|blog-tpi-vs-pga-golf-assessment|clinics-clinical-pilates|clinics-facial-manual-therapy|clinics-golf-swing-assessment|clinics-cosmetic-acupuncture|clinics-microneedling|clinics-im-vitamin-therapy|clinics-iv-vitamin-therapy|clinics-interview-preparation|clinics-singing-voice-therapy|clinics-neurofeedback|clinics-red-light-therapy|clinics-cryotherapy|clinics-head-spa|clinics-medical-botox|clinics-sleep-coaching|clinics-pelvic-floor-physiotherapy|clinics-bike-fitting|clinics-running-gait-analysis|clinics-shockwave-therapy|clinics-tmj-massage|clinics-lymphatic-drainage|clinics-couples-therapy|clinics-mental-performance-coaching|clinics-accent-modification|clinics-myofunctional-therapy|clinics-facial-gua-sha|clinics-sports-nutrition|clinics-fertility-acupuncture|clinics-fertility-consultation)$">
  ForceType text/html
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # /discover (retired swipe page) -> homepage directory
  RewriteRule ^discover$ /#directory [R=301,L,NE]

  # /page.html (or any old bookmark/search-engine link) -> /page
  RewriteCond %{THE_REQUEST} \s/+([^?\s]+)\.html[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L]
</IfModule>

Options -Indexes
