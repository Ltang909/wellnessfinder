<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Discover Providers — WellFinder</title>
  <meta name="description" content="Swipe through wellness providers and save the clinics that feel right for you." />
  <link rel="icon" href="assets/favicon-active.svg" type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400..600;1,9..144,400..500&family=Hanken+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="css/styles.css" />
  <link rel="stylesheet" href="css/discover.css" />
</head>
<body data-page="discover">
  <header class="site-header compact-header">
    <div class="wrap">
      <nav class="nav">
        <a class="brand" href="/"><img src="assets/wellfinder-mark-active.svg" alt="" width="34" height="34" /> WellFinder</a>
        <div class="nav-links compact-nav">
          <a class="discover-nav-active" href="/discover">Discover</a>
          <a href="/#directory">Browse</a>
          <details class="nav-menu">
            <summary>Find Clinics <span aria-hidden="true">⌄</span></summary>
            <div class="nav-menu-panel">
              <a href="/pilates"><strong>Pilates</strong><span>Physio-led movement</span></a>
              <a href="/naturopath"><strong>Naturopathic</strong><span>Skin, IV and wellness</span></a>
              <a href="/golf"><strong>Golf</strong><span>TPI and swing assessments</span></a>
            </div>
          </details>
          <details class="nav-menu">
            <summary>Learn <span aria-hidden="true">⌄</span></summary>
            <div class="nav-menu-panel nav-menu-panel--small">
              <a href="/#insurance"><strong>Insurance Benefits</strong></a>
              <a href="/about"><strong>About WellFinder</strong></a>
            </div>
          </details>
        </div>
        <div class="nav-right">
          <a class="saved-nav" href="/saved" aria-label="View saved providers"><span aria-hidden="true">♡</span> Saved <b id="savedNavCount">0</b></a>
          <a class="btn btn--honey btn--sm founding-cta" href="/#subscribe">Join WellFinder</a>
        </div>
        <button class="nav-toggle" aria-label="Toggle menu" aria-expanded="false" aria-controls="mobileMenu">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
        </button>
      </nav>
    </div>
    <div class="mobile-menu" id="mobileMenu">
      <a href="/discover">Discover</a>
      <a href="/#directory">Browse treatments</a>
      <a href="/saved">♡ Saved benefits</a>
      <p>Find clinics</p>
      <div class="mm-group"><a href="/pilates">Pilates</a><a href="/naturopath">Naturopathic</a><a href="/golf">Golf</a></div>
      <a href="/#insurance">Insurance benefits</a>
      <a href="/about">About</a>
    </div>
  </header>

  <main class="discover-page">
    <section class="discover-shell" aria-labelledby="discoverTitle">
      <div class="discover-intro">
        <div class="discover-progress-row">
          <span id="cardProgress">1 of 11</span><span class="progress-dot" aria-hidden="true"></span><span id="savedProgress">0 saved</span>
        </div>
        <h1 id="discoverTitle">Meet providers that fit your wellness goals.</h1>
        <p>Swipe right to save a provider. Swipe left to pass.</p>
        <div class="discover-progress-track" aria-hidden="true"><span id="progressBar"></span></div>
      </div>

      <div class="discover-stage" id="discoverStage">
        <div class="discover-card-wrap" id="cardWrap" aria-live="polite"></div>
        <div class="swipe-toast" id="swipeToast" role="status" aria-live="polite"></div>
      </div>

      <div class="discover-actions" id="discoverActions">
        <button class="swipe-action swipe-action--skip" id="skipBtn" type="button"><span aria-hidden="true">×</span><strong>Skip</strong></button>
        <button class="swipe-action swipe-action--save" id="saveBtn" type="button"><span aria-hidden="true">♡</span><strong>Save</strong></button>
        <a class="swipe-action swipe-action--clinic" id="clinicBtn" href="/#directory"><span aria-hidden="true">⌖</span><strong>Find Clinics</strong></a>
      </div>
      <p class="drag-hint"><span aria-hidden="true">↔</span> Drag the card or use the buttons</p>
    </section>
  </main>

  <footer class="discover-footer">
    <a href="/saved">View your saved benefits →</a>
    <p>Coverage varies by insurer, plan and provider. Always confirm before booking.</p>
  </footer>

  <dialog class="email-modal" id="emailModal" aria-labelledby="emailTitle">
    <button class="modal-close" id="closeEmailModal" type="button" aria-label="Close">×</button>
    <div class="email-icon" aria-hidden="true">✦</div>
    <p class="eyebrow">Keep your provider shortlist handy</p>
    <h2 id="emailTitle">Save my email</h2>
    <p>Enter your email to complete the shortlist experience and preview future clinic updates.</p>
    <form id="emailForm">
      <label for="discoverEmail">Email address</label>
      <div class="email-row"><input id="discoverEmail" name="email" type="email" autocomplete="email" placeholder="you@example.com" required /><button class="btn btn--primary" type="submit">Save email</button></div>
      <small>No spam. Unsubscribe anytime.</small>
    </form>
    <div class="email-success" id="emailSuccess" hidden><strong>Email saved for this preview.</strong><p>Your saved providers are ready to view right now.</p><a class="btn btn--primary" href="/saved">View saved benefits</a></div>
  </dialog>

  <script src="js/data.js"></script>
  <script src="js/site-nav.js?v=3"></script>
  <script src="js/app.js"></script>
  <script src="js/discover.js?v=providers-1"></script>
</body>
</html>