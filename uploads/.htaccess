# CRITICAL: this folder only ever holds resized JPEGs written by
# portal/image_lib.php. Never let anything in it execute as a script,
# in case someone ever manages to drop a disguised file in here.
<IfModule mod_php.c>
  php_flag engine off
</IfModule>
<IfModule mod_php7.c>
  php_flag engine off
</IfModule>

<FilesMatch "\.(php|phtml|php\d|phar|cgi|pl)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

Options -Indexes
